---
import '../../styles/components/hero-decorations.css';
interface Props { variant: 'background' | 'transition' | 'underline' | 'photo' | 'ribbon'; }
const { variant } = Astro.props;
---
{variant === 'background' && <div class="hero-decor hero-decor--background" aria-hidden="true">
  <svg viewBox="0 0 1600 800" preserveAspectRatio="none" focusable="false">
    <path class="hero-decor__field-light" d="M0 0H520C650 140 670 340 960 460S1380 100 1600 210V800H0Z" />
    <path class="hero-decor__field-mid" d="M350 0H1280L1600 170V800H0V520C270 730 500 520 740 670S1210 680 1600 570V340C1070 650 820 400 650 160Z" />
  </svg>
</div>}
{variant === 'transition' && <div class="hero-transition" aria-hidden="true">
  <svg class="hero-transition__layer hero-transition__layer--green" viewBox="0 0 1600 180" preserveAspectRatio="none" focusable="false"><path d="M0 30C240 160 430 0 690 80S1060 140 1280 65S1490 30 1600 60V200H0Z" /></svg>
  <svg class="hero-transition__layer hero-transition__layer--soft" viewBox="0 0 1600 180" preserveAspectRatio="none" focusable="false"><path d="M0 120C240 10 390 25 640 100S1060 180 1320 80S1510 55 1600 90V200H0Z" /></svg>
  <svg class="hero-transition__layer hero-transition__layer--front" viewBox="0 0 1600 180" preserveAspectRatio="none" focusable="false"><path d="M0 140C220 55 380 50 620 115S1040 205 1300 125S1500 80 1600 110V200H0Z" /></svg>
</div>}
{variant === 'underline' && <svg class="hero-decor hero-decor--underline" viewBox="0 0 360 20" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path d="M5 15Q170 -3 355 14Q178 7 5 19Z" /></svg>}
{variant === 'photo' && <hero-parallax class="hero-decor hero-decor--photo" aria-hidden="true">
  <svg class="hero-decor__illustration hero-decor__bulb" data-hero-motion="bulb" viewBox="0 0 64 80" focusable="false">
    <path d="M23 54C23 46 16 45 16 34A16 16 0 0 1 48 34C48 45 41 46 41 54ZM24 61H40M27 68H37M32 54V40M26 35L32 40L38 35M32 5V11M10 13L15 18M54 13L49 18" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__sparkle" data-hero-motion="sparkle" viewBox="0 0 40 40" focusable="false">
    <path d="M20 5Q20 19 5 21Q20 21 21 36Q22 22 36 20Q21 19 20 5Z" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__pencil" data-hero-motion="pencil" viewBox="0 0 48 64" focusable="false">
    <path d="m12 43 20-34q3-5 8-2t2 7L22 48 9 55ZM12 43l10 5M29 14l10 6M9 55l2-7" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__wave" data-hero-motion="wave" viewBox="0 0 40 72" focusable="false">
    <path pathLength="1" d="M23 5C3 14 35 23 17 34S35 53 14 65" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__geometry" data-hero-motion="geometry" viewBox="0 0 80 40" focusable="false">
    <path d="M6 30Q11 18 18 8Q24 18 30 30Q18 29 6 30Z" />
    <path d="M43 9Q51 9 60 11L58 29Q49 27 41 27Z" />
    <circle cx="70" cy="29" r="5" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__asterisk" data-hero-motion="asterisk" viewBox="0 0 40 40" focusable="false">
    <path d="m18 5 4 30M6 14l28 13M7 30 32 8" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__dots" data-hero-motion="dots" viewBox="0 0 56 24" focusable="false">
    <circle cx="7" cy="16" r="3" /><circle cx="26" cy="7" r="4" /><circle cx="48" cy="15" r="3" />
  </svg>
</hero-parallax>}
{variant === 'ribbon' && <svg class="hero-decor hero-decor--ribbon" viewBox="0 0 120 56" fill="none" focusable="false" aria-hidden="true"><path d="M4 49C35 45 66 17 51 10C31 0 30 42 66 32Q92 26 115 6" /></svg>}

<script>
  import '../../scripts/animations/hero-parallax';
</script>
