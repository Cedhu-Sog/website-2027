---
import '../../styles/components/hero-decorations.css';
interface Props { variant: 'background' | 'underline' | 'photo' | 'ribbon'; }
const { variant } = Astro.props;
---
{variant === 'background' && <div class="hero-decor hero-decor--background" aria-hidden="true" />}
{variant === 'underline' && <svg class="hero-decor hero-decor--underline" viewBox="0 0 360 20" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path d="M5 15Q170 -3 355 14Q178 7 5 19Z" /></svg>}
{variant === 'photo' && <hero-parallax class="hero-decor hero-decor--photo" aria-hidden="true">
  <svg class="hero-decor__illustration hero-decor__bulb" data-parallax="pointer" data-depth="8" viewBox="0 0 64 80" focusable="false">
    <path d="M23 54C23 46 16 45 16 34A16 16 0 0 1 48 34C48 45 41 46 41 54ZM24 61H40M27 68H37M32 54V40M26 35L32 40L38 35M32 5V11M10 13L15 18M54 13L49 18" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__sparkle" data-parallax="pointer" data-depth="-5" viewBox="0 0 40 40" focusable="false">
    <path d="M20 5Q20 19 5 21Q20 21 21 36Q22 22 36 20Q21 19 20 5Z" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__pencil" data-parallax="scroll" data-depth="22" viewBox="0 0 48 64" focusable="false">
    <path d="m12 43 20-34q3-5 8-2t2 7L22 48 9 55ZM12 43l10 5M29 14l10 6M9 55l2-7" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__wave" data-parallax="scroll" data-depth="-18" viewBox="0 0 40 72" focusable="false">
    <path d="M23 5C3 14 35 23 17 34S35 53 14 65" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__geometry" data-parallax="scroll" data-depth="28" viewBox="0 0 80 40" focusable="false">
    <path d="M6 30Q11 18 18 8Q24 18 30 30Q18 29 6 30ZM43 9Q51 9 60 11L58 29Q49 27 41 27Z" />
    <circle cx="70" cy="29" r="5" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__asterisk" data-parallax="pointer" data-depth="-10" viewBox="0 0 40 40" focusable="false">
    <path d="m18 5 4 30M6 14l28 13M7 30 32 8" />
  </svg>
  <svg class="hero-decor__illustration hero-decor__dots" data-parallax="pointer" data-depth="6" viewBox="0 0 56 24" focusable="false">
    <circle cx="7" cy="16" r="3" /><circle cx="26" cy="7" r="4" /><circle cx="48" cy="15" r="3" />
  </svg>
</hero-parallax>}
{variant === 'ribbon' && <svg class="hero-decor hero-decor--ribbon" viewBox="0 0 120 56" fill="none" focusable="false" aria-hidden="true"><path d="M4 49C35 45 66 17 51 10C31 0 30 42 66 32Q92 26 115 6" /></svg>}

<script>
  import '../../scripts/animations/hero-parallax';
</script>
