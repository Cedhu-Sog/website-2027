---
interface Props { eyebrow: string; title: string; description?: string; href?: string; linkLabel?: string; }
const { eyebrow, title, description, href, linkLabel } = Astro.props;
---
<div class="section-heading">
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>
  {description && <p>{description}</p>}
  {href && <a class="text-link" href={href}>{linkLabel}</a>}
</div>
