---
import { getPageSection, type PageSection } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/editorial.css';
const content = Astro.props.content ?? await getPageSection('nosotros', 'institutionOverview');
interface Props { content?: PageSection<'institutionOverview'>; }
---
<section class="section container editorial-split"><div><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2></div><div class="prose"><p>{content.introduction}</p><p>{content.educationalApproach}</p><p>{content.familyDescription}</p><a class="text-link" href={content.historyLinkHref}>{content.historyLinkLabel} <span aria-hidden="true">↗</span></a></div></section>
<section class="section section--tint" id="horizonte"><div class="container"><p class="eyebrow">{content.horizonEyebrow}</p><div class="editorial-split"><div class="prose"><h2>{content.missionTitle}</h2><p>{content.mission}</p></div><div class="prose"><h2>{content.visionTitle}</h2><p>{content.vision}</p></div></div></div></section>
<section class="section container editorial-split"><Photo name={content.image} /><div><p class="eyebrow">{content.identityEyebrow}</p><h2>{content.identityTitleStart}<br />{content.identityTitleEnd}</h2><div class="related-links"><a href={content.principlesLinkHref}><span>{content.principlesLinkLabel}</span><span aria-hidden="true">↗</span></a><a href={content.pedagogyLinkHref}><span>{content.pedagogyLinkLabel}</span><span aria-hidden="true">↗</span></a><a href={content.spacesLinkHref}><span>{content.spacesLinkLabel}</span><span aria-hidden="true">↗</span></a><a href={content.teamLinkHref}><span>{content.teamLinkLabel}</span><span aria-hidden="true">↗</span></a><a href={content.documentsLinkHref}><span>{content.documentsLinkLabel}</span><span aria-hidden="true">↗</span></a></div></div></section>
