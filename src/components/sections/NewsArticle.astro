---
import type { NewsItem } from '../../lib/content';
import Photo from '../common/Photo.astro';
import { media } from '../../data/media';
import '../../styles/components/news.css';
interface Props { item: NewsItem; }
const { item } = Astro.props;
---
<article class="container">
  <header class="article-header"><p class="eyebrow">{item.category} · {item.date ? <time datetime={item.date}>{item.dateLabel}</time> : item.dateLabel}</p><h1>{item.title}</h1><p>{item.description}</p></header>
  <div class="article-layout"><div class="article-layout__copy">{item.archived && <aside class="note">{item.archiveNotice}</aside>}<slot /><a class="text-link" href={media[item.poster].src.src} target="_blank" rel="noopener noreferrer">Consultar comunicado original <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a><div class="article-related"><a class="text-link" href="/noticias/">Volver a la actualidad <span aria-hidden="true">←</span></a></div></div><figure class="article-layout__poster"><Photo name={item.poster} priority sizes="(min-width: 768px) 40vw, 90vw"/><figcaption>{item.imageCaption}</figcaption></figure></div>
</article>
