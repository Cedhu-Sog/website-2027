---
import { getPageSection, type PageSection } from '../../lib/content';
import '../../styles/components/faq.css';
const content = Astro.props.content ?? await getPageSection('admisiones', 'faq');
interface Props { compact?: boolean; content?: PageSection<'faq'>; }
const { compact = false } = Astro.props;
---
<section class="faq section container" id="preguntas" aria-labelledby="faq-title"><div><p class="eyebrow">{content.eyebrow}</p><h2 id="faq-title">{content.titleStart}<br />{content.titleEnd}</h2><p>{content.introduction}</p><a class="text-link" href={content.linkHref}>{content.linkLabel}</a></div><div class="faq__items">{(compact ? content.items.slice(0,3) : content.items).map(item => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><div><p>{item.answer}</p></div></details>)}</div></section>
