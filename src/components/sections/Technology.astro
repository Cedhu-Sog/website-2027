---
import { getPageSection, type PageSection } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/technology.css';
const content = Astro.props.content ?? await getPageSection('inicio', 'technology');
const areas = content.areas;
interface Props { content?: PageSection<'technology'>; }
---
<section class="technology section section--dark" aria-labelledby="technology-title"><div class="container">
  <div class="technology__heading">
    <div data-reveal="up" data-reveal-preset="editorial"><p class="eyebrow">{content.eyebrow}</p><h2 id="technology-title">{content.titleStart}<br />{content.titleEnd} <em>{content.titleEmphasis}</em></h2></div>
    <p data-reveal="up" data-reveal-preset="editorial" data-reveal-delay="content">{content.introduction}</p>
  </div>
  <div class="technology__body">
    <figure data-reveal="up" data-reveal-preset="photo-technology" data-reveal-delay="content">
      <Photo name={content.image} />
      <figcaption>{content.photoCaptionStart} <span aria-hidden="true">/</span> {content.photoCaptionEnd}</figcaption>
    </figure>
    <div class="technology__areas" data-reveal-group>
      {areas.map((area, i) => <a href={area.href} data-reveal="up" data-reveal-preset="editorial"><span class="technology__number">0{i+1}</span><span><strong>{area.name}</strong><span>{area.description}</span></span></a>)}
      <a class="text-link" href={content.linkHref} data-reveal="up" data-reveal-preset="editorial">{content.linkLabel}</a>
    </div>
  </div>
</div></section>
