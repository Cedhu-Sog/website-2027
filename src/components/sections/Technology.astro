---
import { getPageSection, type PageSection } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/technology.css';
const content = Astro.props.content ?? await getPageSection('inicio', 'technology');
const areas = content.areas;
interface Props { content?: PageSection<'technology'>; }
---
<section class="technology section section--dark" aria-labelledby="technology-title"><div class="container">
  <div class="technology__heading"><div><p class="eyebrow">{content.eyebrow}</p><h2 id="technology-title">{content.titleStart}<br />{content.titleEnd} <em>{content.titleEmphasis}</em></h2></div><p>{content.introduction}</p></div>
  <div class="technology__body"><figure><Photo name={content.image} /><figcaption>{content.photoCaptionStart} <span aria-hidden="true">/</span> {content.photoCaptionEnd}</figcaption></figure><div class="technology__areas">{areas.map((area, i) => <a href={area.href}><span class="technology__number">0{i+1}</span><span><strong>{area.name}</strong><span>{area.description}</span></span></a>)}<a class="text-link" href={content.linkHref}>{content.linkLabel}</a></div></div>
</div></section>
