---
import { getPageSection, type PageSection } from '../../lib/content';
import { getStaffSections } from '../../lib/personal';
import StaffSection from './StaffSection.astro';
import '../../styles/components/staff.css';
import '../../styles/components/editorial.css';
const content = Astro.props.content ?? await getPageSection('equipo', 'institutionTeam');
const sections = await getStaffSections();
interface Props { content?: PageSection<'institutionTeam'>; }
---
<div class="section container staff-directory" id="personal">
  <nav class="staff-navigation" aria-label="Categorías del personal">
    {sections.map(section => <a class="text-link" href={`#personal-${section.id}`}>{section.title}</a>)}
  </nav>
  {sections.map(section => <StaffSection section={section} />)}
</div>
<section class="section section--tint"><div class="container editorial-split"><div><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2></div><div class="prose"><p>{content.introduction}</p><p>{content.contactDescription}</p><div class="actions"><a class="button" href={content.contactHref}>{content.contactLabel}</a><a class="text-link" href={content.hoursHref}>{content.hoursLabel}</a></div></div></div></section>

<script>import '../../scripts/interactions/staff-dialog';</script>
