---
import { getPageSection, type PageSection } from '../../lib/content';
import { getEducationPages } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/editorial.css';
const content = Astro.props.content ?? await getPageSection('oferta-educativa', 'educationOverview');
const education = (await getEducationPages());
interface Props { content?: PageSection<'educationOverview'>; }
---
<section class="section container editorial-split"><div><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2></div><div class="prose"><p>{content.introduction}</p><p>{content.methodologyDescription}</p><a class="text-link" href={content.pedagogyLinkHref}>{content.pedagogyLinkLabel} <span aria-hidden="true">↗</span></a></div></section>
<section class="section section--tint"><div class="container editorial-split"><div><p class="eyebrow">{content.explorationEyebrow}</p><h2>{content.explorationTitle}</h2><div class="related-links"><a href={content.researchLinkHref}><span>{content.researchLinkLabel}</span><span aria-hidden="true">↗</span></a>{education.slice(3).map(item => <a href={`/oferta-educativa/${item.slug}/`}><span>{item.name}</span><span aria-hidden="true">↗</span></a>)}</div></div><Photo name={content.image} /></div></section>
