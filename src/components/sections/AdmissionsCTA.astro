---
import { getPageSection, type PageSection } from '../../lib/content';
import Icon from '../common/Icon.astro';
import { site } from '../../data/site';
import '../../styles/components/admissions-cta.css';
const content = Astro.props.content ?? await getPageSection('admisiones', 'admissionsCta');
interface Props { content?: PageSection<'admissionsCta'>; }
---
<section class="admissions-cta" aria-labelledby="admissions-cta-title">
  <div class="container admissions-cta__inner">
    <div data-reveal="up" data-reveal-preset="cta">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="admissions-cta-title">{content.titleStart}<br />{content.titleEnd}</h2>
    </div>
    <div>
      <p data-reveal="fade" data-reveal-preset="cta">{content.description}</p>
      <div class="admissions-cta__actions" data-reveal="up" data-reveal-preset="cta" data-reveal-delay="actions">
        <a class="button" href={content.linkHref}>
          <Icon name="arrow" /><span class="admissions-cta__label-full">{content.linkLabel}</span><span class="admissions-cta__label-short">Visítanos</span>
        </a>
        <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Solicita información<span class="sr-only"> por WhatsApp (abre en otra pestaña)</span><Icon /></a>
      </div>
    </div>
  </div>
</section>
