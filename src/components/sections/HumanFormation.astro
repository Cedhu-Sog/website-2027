---
import { getPageSection, type PageSection } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/human-formation.css';
const content = Astro.props.content ?? await getPageSection('inicio', 'humanFormation');
interface Props { content?: PageSection<'humanFormation'>; }
---
<section class="human-formation section container" aria-labelledby="human-title">
  <div class="human-formation__photo"><Photo name={content.image} /><span>{content.photoCaption}</span></div>
  <div class="human-formation__copy"><p class="eyebrow">{content.eyebrow}</p><h2 id="human-title">{content.titleStart}<br />{content.titleEnd} <em>{content.titleEmphasis}</em></h2><p>{content.introduction}</p><p>{content.supportDescription}</p><a class="text-link" href={content.linkHref}>{content.linkLabel}</a></div>
</section>
