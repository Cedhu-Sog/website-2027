---
import { getPageSection, type PageSection } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/human-formation.css';
const content = Astro.props.content ?? await getPageSection('inicio', 'humanFormation');
interface Props { content?: PageSection<'humanFormation'>; }
---
<section class="human-formation section container" aria-labelledby="human-title">
  <div class="human-formation__photo" data-reveal="left" data-reveal-preset="photo-human"><Photo name={content.image} /><span>{content.photoCaption}</span></div>
  <div class="human-formation__copy">
    <p class="eyebrow" data-reveal="up">{content.eyebrow}</p>
    <h2 id="human-title" data-reveal="up" data-reveal-delay="content">{content.titleStart}<br />{content.titleEnd} <em>{content.titleEmphasis}</em></h2>
    <p data-reveal="up" data-reveal-delay="actions">{content.introduction}</p>
    <p data-reveal="up" data-reveal-delay="actions">{content.supportDescription}</p>
    <a class="text-link" href={content.linkHref} data-reveal="up" data-reveal-delay="actions">{content.linkLabel}</a>
  </div>
</section>
