---
import { getEducationPages, getPageSection, type EducationPage } from '../../lib/content';
import Photo from '../common/Photo.astro';
import '../../styles/components/editorial.css';
const education = await getEducationPages();
const content = await getPageSection('oferta-educativa', 'educationInterface');
interface Props { page: EducationPage; }
const { page } = Astro.props;
const related = education.filter(item => page.related.includes(item.slug));
---
<section class="section container editorial-split" id="enfoques"><div><p class="eyebrow">{content.methodologyEyebrow}</p><h2>{page.methodology}</h2></div><div class="prose"><p>{page.description}</p><div class="editorial-list">{page.focus.map((focus, i) => <article><span class="editorial-list__number">0{i+1}</span><div><h3>{focus.title}</h3><p>{focus.text}</p></div></article>)}</div></div></section>
{page.slug === 'inicial' && page.supplement && <section class="section section--tint"><div class="container editorial-split"><div><p class="eyebrow">{page.supplement.eyebrow}</p><h2>{page.supplement.title}</h2></div><div class="prose"><p>{page.supplement.introduction}</p><p>{page.supplement.familyDescription}</p><a class="text-link" href="/admisiones/">{page.supplement.linkLabel}</a></div></div></section>}
{page.slug === 'formacion-integral' && page.supplement && <section class="section section--tint"><div class="container editorial-split"><Photo name={page.supplement.image!} /><div class="prose"><p class="eyebrow">{page.supplement.eyebrow}</p><h2>{page.supplement.title}</h2><p>{page.supplement.introduction}</p><a class="text-link" href="/ludicas/">{page.supplement.linkLabel}</a></div></div></section>}
<section class="section container"><p class="eyebrow">{content.relatedEyebrow}</p><div class="related-links">{related.map(item => <a href={`/oferta-educativa/${item.slug}/`}><span>{item.name}</span></a>)}<a href="/nosotros/pedagogia-de-la-felicidad/"><span>{content.pedagogyLabel}</span></a></div></section>
