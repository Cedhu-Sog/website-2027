---
import { getPageSection, type PageSection } from '../../lib/content';
import { site } from '../../data/site';
import { Image } from 'astro:assets';
import Icon from '../common/Icon.astro';
import Photo from '../common/Photo.astro';
import q10Logo from '../../assets/images/q10.png';
import unoiLogo from '../../assets/images/unoi.png';
import alumniPhoto from '../../assets/fotos-cedhu/graduacion-cedhu.jpg';
import '../../styles/components/page-hero.css';
import '../../styles/components/resources.css';
import '../../styles/components/editorial.css';
const content = Astro.props.content ?? await getPageSection('servicios-en-linea', 'services');
interface Props { content?: PageSection<'services'>; }
const services = [
  { id: 'q10', name: content.q10Name, tagline: content.q10Title, description: content.q10Description, label: content.q10Label, href: site.q10, image: q10Logo, alt: 'Logo de Q10', isLogo: true, primary: true },
  { id: 'unoi', name: content.unoiName, tagline: content.unoiTitle, description: content.unoiDescription, label: content.unoiLabel, href: site.unoi, image: unoiLogo, alt: 'Logo de UNOi', isLogo: true, primary: false },
  { id: 'egresados', name: content.alumniTitle, tagline: content.alumniEyebrow, description: content.alumniDescription, label: content.alumniLabel, href: content.alumniHref, image: alumniPhoto, alt: 'Egresados del CEDHU con toga, birrete y diplomas durante su ceremonia de graduación.', isLogo: false, primary: false },
];
---
<div class="section container service-grid">
{services.map(service => (
  <section class="service-section" aria-labelledby={`service-${service.id}`}>
      <a class:list={['service-section__visual', service.isLogo ? 'service-section__logo' : 'page-hero__image', service.id === 'unoi' && 'service-section__logo--unoi']} href={service.href} target="_blank" rel="noopener noreferrer" aria-label={`${service.label}${service.id === 'egresados' ? ' en la Red de Egresados' : ''} (abre en otra pestaña)`}>
        {service.isLogo
          ? <Image src={service.image} alt={service.alt} loading="lazy" decoding="async" />
          : <Photo image={service.image} alt={service.alt} sizes="(min-width: 1200px) 250px, (min-width: 768px) 38vw, 90vw" />}
      </a>
      <div class="service-section__content">
        <h2 id={`service-${service.id}`}>{service.name}</h2>
        <p class="service-section__tagline">{service.tagline}</p>
        <p class="page-hero__intro">{service.description}</p>
        <div class="actions">
          <a class:list={['button', !service.primary && 'button--outline']} href={service.href} target="_blank" rel="noopener noreferrer">
            {service.label}<Icon name="external" /><span class="sr-only">{service.id === 'egresados' && ' en la Red de Egresados'} (abre en otra pestaña)</span>
          </a>
        </div>
      </div>
  </section>
))}
</div>
<section class="section section--tint"><div class="container editorial-split"><div><p class="eyebrow">{content.resourcesEyebrow}</p><h2>{content.resourcesTitle}</h2></div><div class="related-links"><a href={content.hoursHref}><span>{content.hoursLabel}</span></a><a href={content.suppliesHref}><span>{content.suppliesLabel}</span></a><a href={content.activitiesHref}><span>{content.activitiesLabel}</span></a><a href={content.documentsHref}><span>{content.documentsLabel}</span></a></div></div></section>
<section class="section container editorial-split"><div><p class="eyebrow">{content.treasuryEyebrow}</p><h2>{content.treasuryTitle}</h2></div><div class="prose"><h3>{content.paymentsTitle}</h3><p>{content.paymentsDescription}</p><a class="text-link" href={content.treasuryHref}>{content.treasuryLabel}</a><h3>{content.booksTitle}</h3><p>{content.booksDescription}</p><a class="text-link" href={content.booksHref} target="_blank" rel="noopener noreferrer">{content.booksLabel}<span class="sr-only"> (abre en otra pestaña)</span></a></div></section>
