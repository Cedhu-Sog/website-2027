---
import { getPageSection, type PageSection } from '../../lib/content';
import { site } from '../../data/site';
import '../../styles/components/admissions.css';
const content = Astro.props.content ?? await getPageSection('admisiones', 'admissionsProcess');
const steps = content.steps;
interface Props { content?: PageSection<'admissionsProcess'>; }
---
<section class="admissions-start section container"><div><p class="eyebrow">{content.eyebrow}</p><h2>{content.titleStart}<br />{content.titleEnd}</h2></div><div class="prose"><p>{content.introduction}</p><aside class="note"><p><strong>{content.noticeTitle}</strong></p><p>{content.noticeDescription}</p></aside><div class="actions"><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">{content.whatsappLabel}<span class="sr-only"> (abre en otra pestaña)</span></a><a class="text-link" href={site.phones[0].href}>{content.phoneLabel}</a></div></div></section>
<section class="section section--white" id="proceso"><div class="container"><div class="section-heading"><div><p class="eyebrow">{content.processEyebrow}</p><h2>{content.processTitle}</h2></div><p>{content.processDescription}</p></div><ol class="admissions-steps">{steps.map((step,i) => <li><span class="admissions-steps__number">0{i+1}</span><div><h3>{step.title}</h3><p>{step.text}</p>{step.href && <a class="text-link" href={step.href} target={step.href.startsWith('https') ? '_blank' : undefined} rel={step.href.startsWith('https') ? 'noopener noreferrer' : undefined}>{step.label}{step.href.startsWith('https') && <span class="sr-only"> (abre en otra pestaña)</span>}</a>}</div></li>)}</ol></div></section>
<section class="section container admissions-start"><div><p class="eyebrow">{content.documentsEyebrow}</p><h2>{content.documentsTitle}</h2></div><div class="prose"><p>{content.documentsDescription}</p><p>{content.documentsNotice}</p><a class="text-link" href={content.documentsLinkHref}>{content.documentsLinkLabel}</a></div></section>
