---
import { getPageSection, type PageSection } from '../../lib/content';
import '../../styles/components/resources.css';
const content = Astro.props.content ?? await getPageSection('documentos', 'documentsList');
interface Props { content?: PageSection<'documentsList'>; }
---
<section class="section container resources-layout"><aside class="resources-intro"><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2><p>{content.description}</p><a class="text-link" href={content.linkHref}>{content.linkLabel} <span aria-hidden="true">↗</span></a></aside><div class="resource-list">{content.items.map(doc => <article id={doc.id}><div><span class="eyebrow">{doc.category}</span><h3><a href={`/documentos/${doc.file}`} target="_blank" rel="noopener noreferrer">{doc.title}<span class="sr-only"> (PDF, abre en otra pestaña)</span></a></h3><p>{doc.description}</p></div><a class="resource-list__download" href={`/documentos/${doc.file}`} download aria-label={`Descargar ${doc.title}, PDF`}>PDF <span aria-hidden="true">↓</span></a></article>)}</div></section>
