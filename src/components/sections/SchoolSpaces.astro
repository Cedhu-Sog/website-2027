---
import Photo from '../common/Photo.astro';
import '../../styles/components/editorial.css';

const content = Astro.props.content ?? await getPageSection('espacios', 'schoolSpaces');
const spaces = content.spaces;
interface Props { content?: PageSection<'schoolSpaces'>; }
---
<section class="section container"><p class="eyebrow">{content.eyebrow}</p><div class="media-gallery">{spaces.map(space => <figure><Photo name={space.image}/><figcaption><h3>{space.title}</h3><p>{space.text}</p></figcaption></figure>)}</div></section>
<section class="section section--tint"><div class="container video-panel"><Photo name={content.image} /><div><p class="eyebrow">{content.tourEyebrow}</p><h2>{content.tourTitle}</h2><p>{content.tourDescription}</p><div class="actions"><a class="text-link" href={content.tourHref} target="_blank" rel="noopener noreferrer">{content.tourLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (video en otra pestaña)</span></a><a class="button" href={content.visitHref}>{content.visitLabel}</a></div></div></div></section>
