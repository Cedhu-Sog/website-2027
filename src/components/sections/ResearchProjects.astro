---
import { getPageSection, getResearchProjects, type PageSection } from '../../lib/content';
import ResearchProject from '../common/ResearchProject.astro';
import '../../styles/components/research.css';
const content = Astro.props.content ?? await getPageSection('investigacion', 'researchProjects');
const projects = getResearchProjects(content.projects);
interface Props { content?: PageSection<'researchProjects'>; }
---
<section class="section container research-intro" aria-labelledby="research-intro-title">
  <div><p class="eyebrow">{content.eyebrow}</p><h2 id="research-intro-title">{content.title}</h2></div>
  <div class="prose"><p>{content.introduction}</p><p>{content.publicationsDescription}</p></div>
</section>
<section class="section section--tint" id="proyectos" aria-labelledby="research-projects-title">
  <div class="container">
    <header class="research-heading"><p class="eyebrow">{content.projectsEyebrow}</p><h2 id="research-projects-title">{content.projectsTitle}</h2></header>
    {projects.length ? <div class="research-projects">{projects.map(project => <ResearchProject project={project} />)}</div> :
      <div class="research-empty"><p class="research-empty__title">{content.emptyTitle}</p><p>{content.emptyDescription}</p><a class="text-link" href={content.educationLinkHref}>{content.educationLinkLabel}</a></div>
    }
  </div>
</section>
