---
import { getPageSection, type PageSection } from '../../lib/content';
import '../../styles/components/quick-access.css';
const content = Astro.props.content ?? await getPageSection('inicio', 'quickAccess');
const links = content.links;
interface Props { content?: PageSection<'quickAccess'>; }
---
<section class="quick-access" aria-labelledby="quick-title"><div class="container quick-access__inner"><div><p class="eyebrow">{content.eyebrow}</p><h2 id="quick-title">{content.titleStart}<br />{content.titleEnd}</h2></div><div class="quick-access__links">{links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}><span><strong>{link.label}</strong><span>{link.detail}</span></span>{link.external && <span class="sr-only"> (abre en otra pestaña)</span>}</a>)}</div></div></section>
