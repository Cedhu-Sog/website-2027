---
import { getPageSection, type PageSection } from '../../lib/content';
import { site } from '../../data/site';
import '../../styles/components/contact.css';
const content = Astro.props.content ?? await getPageSection('contacto', 'contactDetails');
interface Props { content?: PageSection<'contactDetails'>; }
---
<section class="contact section container" aria-label="Canales de contacto"><div class="contact__channels"><article><p class="eyebrow">{content.emailEyebrow}</p><h2>{content.emailTitle}</h2><a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">{content.whatsappLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a></article><article><p class="eyebrow">{content.phoneEyebrow}</p>{site.phones.map(phone => <a class="contact__phone" href={phone.href}>{phone.label}<span aria-hidden="true">↗</span></a>)}</article><article><p class="eyebrow">{content.visitEyebrow}</p><address>{site.address}<br />{content.neighborhood}<br />{site.city}{content.countrySuffix}</address><a class="text-link" href={site.maps} target="_blank" rel="noopener noreferrer">{content.mapsLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (abre Google Maps en otra pestaña)</span></a></article></div><div class="contact__hours"><p class="eyebrow">{content.hoursEyebrow}</p><h2>{content.hoursTitle}</h2><dl><div><dt>{content.generalHoursLabel}</dt><dd>{content.weekdays}<br />{content.morningHours}<br />{content.afternoonHours}</dd></div><div><dt>{content.appointmentLabel}</dt><dd>{content.appointmentNotice}<br />{content.appointmentInstructions}</dd></div></dl><p>{content.hoursNotice}</p><a class="text-link" href={content.hoursLinkHref}>{content.hoursLinkLabel} <span aria-hidden="true">↗</span></a></div></section>
<section class="contact-map container" aria-labelledby="map-title"><div class="section-heading"><div><p class="eyebrow">{content.mapEyebrow}</p><h2 id="map-title">{content.mapTitle}</h2></div><a class="text-link" href={site.maps} target="_blank" rel="noopener noreferrer">{content.mapLinkLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a></div><iframe src={site.mapEmbed} title="Ubicación del Centro de Desarrollo Humano CEDHU en Sogamoso" width="1200" height="430" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></section>
