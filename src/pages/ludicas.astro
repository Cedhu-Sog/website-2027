---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsList from '../components/sections/EventsList.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import Activities from '../components/sections/Activities.astro';
import AdmissionsCTA from '../components/sections/AdmissionsCTA.astro';
const page = await getPage('ludicas');
---
<BaseLayout title={page.title} description={page.description} seo={page.seo}><Breadcrumb label="Lúdicas" parent={{label:'Educación',href:'/oferta-educativa/'}} /><PageHero eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} image={page.heroImage} theme="warm" /><Activities /><EventsList /><AdmissionsCTA /></BaseLayout>
