---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import Services from '../components/sections/Services.astro';
const page = await getPage('servicios-en-linea');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Servicios" /><PageHero image={page.heroImage} eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} /><Services /></BaseLayout>
