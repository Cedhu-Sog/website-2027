---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import DocumentsList from '../components/sections/DocumentsList.astro';
const page = await getPage('documentos');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Documentos" /><PageHero image={page.heroImage} eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription}><div class="actions"><a class="text-link" href="#manual">{page.primaryActionLabel} <span aria-hidden="true">↓</span></a></div></PageHero><DocumentsList /></BaseLayout>
