---
import { getPage } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import PageHero from '../../components/sections/PageHero.astro';
import InstitutionOverview from '../../components/sections/InstitutionOverview.astro';
import AdmissionsCTA from '../../components/sections/AdmissionsCTA.astro';
const page = await getPage('nosotros');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Nosotros" /><PageHero eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} image={page.heroImage} /><InstitutionOverview /><AdmissionsCTA /></BaseLayout>
