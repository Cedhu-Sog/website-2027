---
import { getPage } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import PageHero from '../../components/sections/PageHero.astro';
import EducationOverview from '../../components/sections/EducationOverview.astro';
import EducationalLevels from '../../components/sections/EducationalLevels.astro';
import AdmissionsCTA from '../../components/sections/AdmissionsCTA.astro';
const page = await getPage('oferta-educativa');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Educación" /><PageHero image={page.heroImage} eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} /><EducationalLevels /><EducationOverview /><AdmissionsCTA /></BaseLayout>
