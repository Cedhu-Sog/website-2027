---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import AdmissionsProcess from '../components/sections/AdmissionsProcess.astro';
import EducationalLevels from '../components/sections/EducationalLevels.astro';
import FAQ from '../components/sections/FAQ.astro';
const page = await getPage('admisiones');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Admisiones" /><PageHero eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} image={page.heroImage} theme="warm"><div class="actions"><a class="button" href="#proceso">{page.primaryActionLabel}</a><a class="text-link" href="/contacto/">{page.secondaryActionLabel}</a></div></PageHero><AdmissionsProcess /><EducationalLevels /><FAQ /></BaseLayout>
