---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import ContactDetails from '../components/sections/ContactDetails.astro';
import { site } from '../data/site';
const page = await getPage('contacto');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Contacto" /><PageHero image={page.heroImage} eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription}><div class="actions"><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">{page.primaryActionLabel}<span class="sr-only"> (abre en otra pestaña)</span></a><a class="text-link" href={site.phones[0].href}>{page.secondaryActionLabel}</a></div></PageHero><ContactDetails /></BaseLayout>
