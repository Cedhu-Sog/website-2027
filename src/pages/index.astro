---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WhyCedhu from '../components/sections/WhyCedhu.astro';
import QuickAccess from '../components/sections/QuickAccess.astro';
import IdentityIntro from '../components/sections/IdentityIntro.astro';
import EducationalLevels from '../components/sections/EducationalLevels.astro';
import Technology from '../components/sections/Technology.astro';
import HumanFormation from '../components/sections/HumanFormation.astro';
import NewsSection from '../components/sections/NewsSection.astro';
import FAQ from '../components/sections/FAQ.astro';
import AdmissionsCTA from '../components/sections/AdmissionsCTA.astro';
const page = await getPage('inicio');
---
<BaseLayout title={page.title} description={page.description}>
  <Hero page={page} />
  <WhyCedhu />
  <QuickAccess /><IdentityIntro /><EducationalLevels /><Technology /><HumanFormation /><NewsSection /><FAQ compact /><AdmissionsCTA />
</BaseLayout>
