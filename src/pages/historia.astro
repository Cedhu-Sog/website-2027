---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PageHero from '../components/sections/PageHero.astro';
import HistoryTimeline from '../components/sections/HistoryTimeline.astro';
import AdmissionsCTA from '../components/sections/AdmissionsCTA.astro';
const page = await getPage('historia');
---
<BaseLayout title={page.title} description={page.description}><Breadcrumb label="Nuestra historia" parent={{label:'CEDHU',href:'/nosotros/'}} /><PageHero imageCaption={page.heroImageCaption} image={page.heroImage} eyebrow={page.heroEyebrow} title={page.heroTitle} intro={page.heroDescription} /><HistoryTimeline /><AdmissionsCTA /></BaseLayout>
