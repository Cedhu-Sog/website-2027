# Variables de servidor en Vercel > Settings > Environment Variables.
# Nunca usar el prefijo PUBLIC_ para estas variables.
CMS_ORIGIN=https://website-2027-seven.vercel.app
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generar 32 bytes aleatorios como 64 caracteres hexadecimales. Ver documentación.
CMS_OAUTH_COOKIE_SECRET=
# Opcional: cuentas GitHub autorizadas, separadas por comas. Además deben tener Write.
CMS_GITHUB_ALLOWED_USERS=

# Portal de proyectos (independiente de Decap). Valores vacíos no funcionales.
# Generar localmente con npm run proyectos:hash / npm run proyectos:secret.
# Ver docs/PROYECTOS-ACCESO.md. Nunca usar PUBLIC_ ni pegar secretos en el chat.
PROYECTOS_PASSWORD_HASH=
PROYECTOS_SESSION_SECRET=

# Google Workspace: exclusivamente servidor, solo lectura, sin claves JSON.
# Plantilla sin identificadores reales de recursos. Completar en .env.local
# (excluido de Git) y en las variables de Production de Vercel.
# Ver docs/PROYECTOS-GOOGLE.md. Estas nueve variables son necesarias en la prueba completa.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# ID de la UNIDAD COMPARTIDA Repo Investigación (no de 00_Sistema).
PROYECTOS_DRIVE_ROOT_ID=
# Correspondencia confirmada por la administración, independiente del orden de URL:
# METADATA = Catalogo_Proyectos; AUTH = Usuarios_Autorizados; AUDIT = Registro_Actividad.
PROYECTOS_METADATA_SPREADSHEET_ID=
PROYECTOS_AUTH_SPREADSHEET_ID=
PROYECTOS_AUDIT_SPREADSHEET_ID=
# Los encabezados confirmados se validan en src/server/google/config.js.
# Diagnóstico administrativo temporal: cerrado por defecto. Solo Production.
PROYECTOS_GOOGLE_DIAGNOSTICS_ENABLED=false
# Secreto independiente: 32 bytes aleatorios (64 hex minúsculas) de gestor seguro.
PROYECTOS_GOOGLE_DIAGNOSTICS_TOKEN=
# Fecha absoluta ISO 8601 UTC; ventana restante máxima de una hora.
PROYECTOS_GOOGLE_DIAGNOSTICS_EXPIRES_AT=
