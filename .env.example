# Variables de servidor en Vercel > Settings > Environment Variables.
# Nunca usar el prefijo PUBLIC_ para estas variables.
CMS_ORIGIN=https://website-2027-bay.vercel.app
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generar 32 bytes aleatorios como 64 caracteres hexadecimales. Ver documentación.
CMS_OAUTH_COOKIE_SECRET=
# Opcional: cuentas GitHub autorizadas, separadas por comas. Además deben tener Write.
CMS_GITHUB_ALLOWED_USERS=
